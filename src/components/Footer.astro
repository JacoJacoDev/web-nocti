---
import SFSymbol from './SFSymbol.astro';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: "Capabilities",
    links: [
      { href: "#services", label: "Web Development" },
      { href: "#services", label: "UX/UI Design" },
      { href: "#services", label: "Landing Pages" },
      { href: "#services", label: "Corporate Platforms" },
      { href: "#services", label: "E-commerce" },
      { href: "#services", label: "Automations & APIs" },
    ],
  },
  {
    title: "Methodology",
    links: [
      { href: "#process", label: "01 Discovery" },
      { href: "#process", label: "02 Strategy" },
      { href: "#process", label: "03 Design" },
      { href: "#process", label: "04 Development" },
      { href: "#process", label: "05 Launch" },
    ],
  },
  {
    title: "Selected Work",
    links: [
      { href: "#work", label: "Kinetic Archive" },
      { href: "#work", label: "Aura Acoustics" },
      { href: "#work", label: "Strata System" },
      { href: "#work", label: "All Case Studies" },
    ],
  },
  {
    title: "Studio Values",
    links: [
      { href: "#about", label: "Intentionality" },
      { href: "#differentiators", label: "Performance Standards" },
      { href: "#differentiators", label: "Fluid Accessibility" },
      { href: "#differentiators", label: "System Scalability" },
    ],
  },
  {
    title: "Inquiries & Connect",
    links: [
      { href: "mailto:contact@noctivagos.studio", label: "contact@noctivagos.studio" },
      { href: "https://x.com", label: "X (Twitter)" },
      { href: "https://github.com", label: "GitHub" },
      { href: "https://linkedin.com", label: "LinkedIn" },
    ],
  },
];
---

<footer class="relative px-4 sm:px-8 py-10 md:py-12 bg-[#f5f5f7] text-[#1d1d1f] border-t border-[#d2d2d7] text-[12px]">
  <div class="max-w-[1024px] mx-auto">
    <!-- Apple-style Footnotes / Notes Section -->
    <div class="pb-5 border-b border-[#d2d2d7] text-[11px] text-[#86868b] leading-normal space-y-1.5">
      <p>
        1. Noctivagos Studios is an independent technology and design studio. All projects shown are engineered adhering to modern W3C standards, sub-second latency budgets, and rigorous accessibility compliance.
      </p>
      <p>
        2. Performance benchmarks represent production build metrics measured with standard headless Lighthouse and Core Web Vitals tooling under real-world throttled network simulations.
      </p>
    </div>

    <!-- Apple-style Multi-column Directory Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5 sm:gap-6 py-6 sm:py-8">
      {columns.map((col) => (
        <div>
          <h3 class="font-semibold text-[#1d1d1f] tracking-tight mb-2 text-[12px]">
            {col.title}
          </h3>
          <ul class="space-y-1.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[#6e6e73] hover:text-[#1d1d1f] transition-colors text-[11.5px]"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Apple-style Bottom Legal & Copyright Bar -->
    <div class="pt-5 border-t border-[#d2d2d7] flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-[11px] text-[#6e6e73]">
      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5">
        <p>Copyright &copy; {currentYear} Noctivagos Studios. All rights reserved.</p>
        <span class="hidden sm:inline text-[#d2d2d7]">|</span>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Terms of Use</a>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Engineering Standards</a>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Legal</a>
      </div>

      <div class="flex items-center gap-2 text-[#1d1d1f] font-medium">
        <SFSymbol name="globe" class="w-3.5 h-3.5 text-[#86868b]" />
        <span>Global Studio (Remote)</span>
      </div>
    </div>
  </div>
</footer>

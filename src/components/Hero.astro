---
import SFSymbol from "./SFSymbol.astro";
import PixelSnowBackground from "./PixelSnowBackground.astro";
---

<section
  id="hero"
  class="relative flex flex-col justify-center items-center px-4 sm:px-8 pt-20 pb-10 sm:pt-24 sm:pb-12 bg-[#000000] text-[#f5f5f7] overflow-hidden"
>
  <PixelSnowBackground
    clientLoad={true}
    color="#ffffff"
    flakeSize={0.012}
    minFlakeSize={1.25}
    pixelResolution={180}
    speed={1.1}
    depthFade={8}
    farPlane={20}
    brightness={1.1}
    density={0.28}
    variant="round"
    direction={125}
  />
  <div
    class="relative z-10 max-w-[900px] mx-auto w-full text-center flex flex-col items-center"
  >
    <!-- Píldora de eyebrow -->
    <div
      class="reveal-item inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1d1d1f] border border-white/[0.12] text-[12px] font-medium text-[#f5f5f7] mb-4"
    >
      <SFSymbol name="sparkles" class="w-3.5 h-3.5 text-[#2997ff]" />
      <span>Software diseñado para generar impacto</span>
    </div>

    <!-- Titular principal (centrado) -->
    <h1
      class="reveal-item apple-headline-hero text-[#f5f5f7] tracking-tight mb-3 max-w-3xl text-center"
      style="transition-delay: 80ms;"
    >
      Software diseñado para generar impacto.
    </h1>

    <!-- Texto secundario (centrado) -->
    <p
      class="reveal-item apple-body-large text-[#86868b] max-w-xl mx-auto mb-6 font-normal leading-relaxed text-center"
      style="transition-delay: 160ms;"
    >
      Noctivagos Studios diseña y desarrolla experiencias digitales de alto
      rendimiento que combinan estrategia, diseño y tecnología.
    </p>

    <!-- Acciones CTA (centradas) -->
    <div
      class="reveal-item flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-5 mb-8 w-full"
      style="transition-delay: 240ms;"
    >
      <a
        href="#contact"
        class="apple-btn-primary text-[13.5px] px-5 py-2 h-[36px] w-full sm:w-auto"
      >
        <span>Iniciar un proyecto</span>
        <SFSymbol name="chevron.right" class="w-3 h-3" />
      </a>

      <a href="#work" class="apple-link text-[14px]">
        <span>Ver nuestro trabajo</span>
        <SFSymbol name="chevron.right" class="w-3 h-3 text-[#2997ff]" />
      </a>
    </div>

    <!-- Barra de especificaciones técnicas (compacta y centrada) -->
    <div
      class="reveal-item grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-3 w-full pt-6 border-t border-white/[0.12]"
      style="transition-delay: 320ms;"
    >
      <div class="apple-card-dark p-3 sm:p-3.5 flex flex-col justify-between text-left">
        <div class="flex items-center justify-between text-[#86868b] mb-3">
          <span class="apple-caption text-[#86868b]">Arquitectura</span>
          <SFSymbol name="terminal" class="w-3.5 h-3.5 text-[#2997ff]" />
        </div>
        <div>
          <p class="text-[15px] font-semibold text-[#f5f5f7] tracking-tight">
            Full-Stack
          </p>
          <p class="apple-caption text-[#86868b] mt-0.5">
            Estático &amp; en el Edge
          </p>
        </div>
      </div>

      <div class="apple-card-dark p-3 sm:p-3.5 flex flex-col justify-between text-left">
        <div class="flex items-center justify-between text-[#86868b] mb-3">
          <span class="apple-caption text-[#86868b]">Rendimiento</span>
          <SFSymbol name="gauge" class="w-3.5 h-3.5 text-[#30d158]" />
        </div>
        <div>
          <p class="text-[15px] font-semibold text-[#f5f5f7] tracking-tight">
            Sub-segundo
          </p>
          <p class="apple-caption text-[#86868b] mt-0.5">
            Optimizado para Core Web Vitals
          </p>
        </div>
      </div>

      <div class="apple-card-dark p-3 sm:p-3.5 flex flex-col justify-between text-left">
        <div class="flex items-center justify-between text-[#86868b] mb-3">
          <span class="apple-caption text-[#86868b]">Interfaz</span>
          <SFSymbol name="devices" class="w-3.5 h-3.5 text-[#bf5af2]" />
        </div>
        <div>
          <p class="text-[15px] font-semibold text-[#f5f5f7] tracking-tight">
            Adaptable
          </p>
          <p class="apple-caption text-[#86868b] mt-0.5">
            Fluido en cualquier pantalla
          </p>
        </div>
      </div>

      <div class="apple-card-dark p-3 sm:p-3.5 flex flex-col justify-between text-left">
        <div class="flex items-center justify-between text-[#86868b] mb-3">
          <span class="apple-caption text-[#86868b]">Estándar</span>
          <SFSymbol name="lock.shield" class="w-3.5 h-3.5 text-[#ffd60a]" />
        </div>
        <div>
          <p class="text-[15px] font-semibold text-[#f5f5f7] tracking-tight">
            Producción
          </p>
          <p class="apple-caption text-[#86868b] mt-0.5">
            Sin layout shift / ADA
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

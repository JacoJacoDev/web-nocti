---
import SFSymbol from "./SFSymbol.astro";

const globalNav = [
  { href: "#hero", label: "Inicio" },
  { href: "#services", label: "Servicios" },
  { href: "#process", label: "Proceso" },
  { href: "#work", label: "Trabajos" },
  { href: "#differentiators", label: "Estándares" },
  { href: "#contact", label: "Contacto" },
];
---

<!-- Barra de navegación global fija (estándar de 44px) -->
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 apple-nav-blur border-b border-white/[0.08] transition-all duration-300"
>
  <div
    class="max-w-[1024px] mx-auto px-4 sm:px-8 h-[44px] flex items-center justify-between"
  >
    <!-- Marca (logo) -->
    <a
      href="#"
      class="flex items-center hover:opacity-80 transition-opacity duration-200"
      aria-label="Noctivagos Studios"
    >
      <img
        src="/images/brand/logo.png"
        alt="Noctivagos Studios"
        class="h-[50px] w-auto object-contain"
        draggable="false"
      />
    </a>

    <!-- Enlaces de navegación global (escritorio) -->
    <nav
      class="hidden md:flex items-center space-x-7"
      aria-label="Navegación global"
    >
      {
        globalNav.map((item) => (
          <a
            href={item.href}
            class="text-[12px] font-normal tracking-[-0.01em] text-[#86868b] hover:text-[#f5f5f7] transition-colors duration-150"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Botón de acción (píldora compacta) -->
    <div class="flex items-center gap-3">
      <a
        href="#contact"
        class="apple-btn-primary text-[11px] font-medium py-1 px-3 h-[24px]"
      >
        <span>Iniciar un proyecto</span>
        <SFSymbol name="chevron.right" class="w-2.5 h-2.5" />
      </a>

      <!-- Botón de menú hamburguesa (móvil) -->
      <button
        id="menu-toggle-btn"
        class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1 focus:outline-none"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span
          class="menu-line w-4 h-[1.25px] bg-[#f5f5f7] transition-transform duration-250 origin-center"
        ></span>
        <span
          class="menu-line w-4 h-[1.25px] bg-[#f5f5f7] transition-transform duration-250 origin-center"
        ></span>
      </button>
    </div>
  </div>
</header>

<!-- Barra de navegación local fija (subnav, estándar de 52px) -->
<div
  id="local-nav"
  class="fixed top-[44px] left-0 right-0 z-40 bg-[#000000]/70 backdrop-blur-xl border-b border-white/[0.06] transition-opacity duration-200"
>
  <div
    class="max-w-[1024px] mx-auto px-4 sm:px-8 h-[48px] flex items-center justify-between text-[12px]"
  >
    <div
      class="flex items-center gap-2 text-[#f5f5f7] font-medium tracking-tight"
    >
      <span>Estudio Digital & Ingeniería</span>
    </div>

    <div class="hidden sm:flex items-center space-x-6 text-[#86868b]">
      <a href="#services" class="hover:text-[#f5f5f7] transition-colors"
        >Servicios</a
      >
      <a href="#process" class="hover:text-[#f5f5f7] transition-colors"
        >Proceso</a
      >
      <a href="#work" class="hover:text-[#f5f5f7] transition-colors"
        >Casos de éxito</a
      >
      <a
        href="mailto:contact@noctivagos.studio"
        class="text-[#2997ff] hover:text-[#70baff] transition-colors inline-flex items-center gap-1"
      >
        <span>Consultar</span>
        <SFSymbol name="arrow.up.right" class="w-2.5 h-2.5" />
      </a>
    </div>
  </div>
</div>

<!-- Menú móvil superpuesto -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-[#000000]/98 backdrop-blur-2xl flex flex-col justify-between px-6 pt-24 pb-12 pointer-events-none opacity-0 transition-all duration-300 md:hidden"
  aria-hidden="true"
>
  <nav class="flex flex-col space-y-4" aria-label="Navegación móvil">
    <div
      class="text-[11px] font-semibold uppercase tracking-wider text-[#86868b] pb-2 border-b border-white/[0.08]"
    >
      Directorio
    </div>
    {
      globalNav.map((item, idx) => (
        <a
          href={item.href}
          class="mobile-menu-link text-[24px] font-semibold tracking-tight text-[#f5f5f7] hover:text-[#2997ff] transition-colors flex items-center justify-between py-1 border-b border-white/[0.04]"
          style={`transition-delay: ${idx * 30}ms;`}
        >
          <span>{item.label}</span>
          <SFSymbol name="chevron.right" class="w-4 h-4 text-[#86868b]" />
        </a>
      ))
    }
  </nav>

  <div class="pt-6 border-t border-white/[0.08] flex flex-col gap-3">
    <a
      href="#contact"
      class="mobile-menu-link apple-btn-primary text-center justify-center py-3 text-[14px]"
    >
      <span>Iniciar un proyecto</span>
      <SFSymbol name="chevron.right" class="w-3.5 h-3.5" />
    </a>
    <p class="text-[11px] text-[#86868b] text-center tracking-tight">
      Precisión · Tecnología · Diseño · Rendimiento
    </p>
  </div>
</div>

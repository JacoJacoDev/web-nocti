---
import SFSymbol from './SFSymbol.astro';
---

<section
  id="contact"
  class="relative px-4 sm:px-8 py-12 md:py-16 bg-[#000000] text-[#f5f5f7] border-t border-white/[0.08] overflow-hidden"
>
  <div class="relative z-10 max-w-[720px] mx-auto text-center">
    <!-- Apple Eyebrow -->
    <div class="reveal-item inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1d1d1f] border border-white/[0.12] text-[12px] font-medium text-[#f5f5f7] mb-3">
      <SFSymbol name="sparkles" class="w-3.5 h-3.5 text-[#2997ff]" />
      <span>Start Your Project</span>
    </div>

    <!-- Apple Display Headline -->
    <h2 class="reveal-item apple-headline-hero text-[#f5f5f7] tracking-tight mb-3" style="transition-delay: 80ms;">
      Let's build something remarkable.
    </h2>

    <!-- Apple Secondary Narrative (#86868b) -->
    <p class="reveal-item apple-body-large text-[#86868b] max-w-lg mx-auto mb-8 font-normal leading-relaxed text-[14px] sm:text-[15px]" style="transition-delay: 160ms;">
      Have an idea, a business or a digital product that deserves a better experience? Fill out the form below to receive a strategic proposal.
    </p>

    <!-- Apple-grade Client Intake Form -->
    <div
      class="reveal-item apple-card-dark p-6 sm:p-8 text-left border border-white/[0.12] bg-[#121214]/90 backdrop-blur-xl shadow-[0_20px_50px_rgba(0,0,0,0.6)] mb-8"
      style="transition-delay: 240ms;"
    >
      <form id="cta-contact-form" class="space-y-5">
        <!-- Row 1: Name & Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="client-name" class="block text-[12px] font-medium text-[#f5f5f7]">
              Nombre completo <span class="text-[#2997ff]">*</span>
            </label>
            <input
              type="text"
              id="client-name"
              name="name"
              required
              placeholder="Steve Jobs"
              class="w-full bg-[#000000]/60 border border-white/[0.12] rounded-xl px-3.5 py-2.5 text-[13.5px] text-[#f5f5f7] placeholder-[#6e6e73] focus:outline-none focus:border-[#2997ff] focus:ring-1 focus:ring-[#2997ff]/50 transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label for="client-email" class="block text-[12px] font-medium text-[#f5f5f7]">
              Correo electrónico <span class="text-[#2997ff]">*</span>
            </label>
            <input
              type="email"
              id="client-email"
              name="email"
              required
              placeholder="tu@empresa.com"
              class="w-full bg-[#000000]/60 border border-white/[0.12] rounded-xl px-3.5 py-2.5 text-[13.5px] text-[#f5f5f7] placeholder-[#6e6e73] focus:outline-none focus:border-[#2997ff] focus:ring-1 focus:ring-[#2997ff]/50 transition-colors"
            />
          </div>
        </div>

        <!-- Row 2: Phone / WhatsApp & Service -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="client-phone" class="block text-[12px] font-medium text-[#f5f5f7]">
              Teléfono / WhatsApp <span class="text-[#86868b] font-normal text-[11px]">(opcional)</span>
            </label>
            <input
              type="tel"
              id="client-phone"
              name="phone"
              placeholder="+54 9 11 ..."
              class="w-full bg-[#000000]/60 border border-white/[0.12] rounded-xl px-3.5 py-2.5 text-[13.5px] text-[#f5f5f7] placeholder-[#6e6e73] focus:outline-none focus:border-[#2997ff] focus:ring-1 focus:ring-[#2997ff]/50 transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label for="client-service" class="block text-[12px] font-medium text-[#f5f5f7]">
              Servicio de interés <span class="text-[#2997ff]">*</span>
            </label>
            <div class="relative">
              <select
                id="client-service"
                name="service"
                required
                class="w-full appearance-none bg-[#000000]/60 border border-white/[0.12] rounded-xl px-3.5 py-2.5 text-[13.5px] text-[#f5f5f7] focus:outline-none focus:border-[#2997ff] focus:ring-1 focus:ring-[#2997ff]/50 transition-colors cursor-pointer pr-10"
              >
                <option value="" disabled selected class="bg-[#161617] text-[#86868b]">Selecciona un servicio</option>
                <option value="web-development" class="bg-[#161617] text-[#f5f5f7]">Desarrollo Web de Alto Rendimiento</option>
                <option value="ux-ui-design" class="bg-[#161617] text-[#f5f5f7]">Diseño de Interfaces UX/UI</option>
                <option value="landing-pages" class="bg-[#161617] text-[#f5f5f7]">Landing Page de Conversión</option>
                <option value="corporate-web" class="bg-[#161617] text-[#f5f5f7]">Plataforma o Web Corporativa</option>
                <option value="ecommerce" class="bg-[#161617] text-[#f5f5f7]">E-commerce a Medida</option>
                <option value="automation" class="bg-[#161617] text-[#f5f5f7]">Automatizaciones & APIs</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#86868b]">
                <SFSymbol name="chevron.right" class="w-3 h-3 rotate-90" />
              </div>
            </div>
          </div>
        </div>

        <!-- Budget Range Selection -->
        <div class="space-y-2">
          <label class="block text-[12px] font-medium text-[#f5f5f7]">
            Presupuesto estimado <span class="text-[#86868b] font-normal text-[11px]">(USD)</span>
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <label class="cursor-pointer">
              <input type="radio" name="budget" value="< 1.5k" class="peer sr-only" />
              <div class="text-center py-2 px-2.5 rounded-lg border border-white/[0.1] bg-[#000000]/40 text-[12px] font-medium text-[#86868b] peer-checked:border-[#2997ff] peer-checked:bg-[#2997ff]/10 peer-checked:text-[#f5f5f7] transition-all">
                &lt; $1,500
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="budget" value="1.5k - 3.5k" class="peer sr-only" checked />
              <div class="text-center py-2 px-2.5 rounded-lg border border-white/[0.1] bg-[#000000]/40 text-[12px] font-medium text-[#86868b] peer-checked:border-[#2997ff] peer-checked:bg-[#2997ff]/10 peer-checked:text-[#f5f5f7] transition-all">
                $1,500 – $3,500
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="budget" value="3.5k - 7k" class="peer sr-only" />
              <div class="text-center py-2 px-2.5 rounded-lg border border-white/[0.1] bg-[#000000]/40 text-[12px] font-medium text-[#86868b] peer-checked:border-[#2997ff] peer-checked:bg-[#2997ff]/10 peer-checked:text-[#f5f5f7] transition-all">
                $3,500 – $7,000
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="budget" value="7k+" class="peer sr-only" />
              <div class="text-center py-2 px-2.5 rounded-lg border border-white/[0.1] bg-[#000000]/40 text-[12px] font-medium text-[#86868b] peer-checked:border-[#2997ff] peer-checked:bg-[#2997ff]/10 peer-checked:text-[#f5f5f7] transition-all">
                $7,000+
              </div>
            </label>
          </div>
        </div>

        <!-- Project Details Textarea -->
        <div class="space-y-1.5">
          <label for="client-message" class="block text-[12px] font-medium text-[#f5f5f7]">
            Cuéntanos sobre tu proyecto <span class="text-[#2997ff]">*</span>
          </label>
          <textarea
            id="client-message"
            name="message"
            rows="3"
            required
            placeholder="Objetivos clave, referencias visuales, funcionalidades deseadas o fecha límite..."
            class="w-full bg-[#000000]/60 border border-white/[0.12] rounded-xl px-3.5 py-2.5 text-[13.5px] text-[#f5f5f7] placeholder-[#6e6e73] focus:outline-none focus:border-[#2997ff] focus:ring-1 focus:ring-[#2997ff]/50 transition-colors resize-y min-h-[80px]"
          ></textarea>
        </div>

        <!-- Submit & Direct Options -->
        <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
          <button
            type="submit"
            id="cta-submit-btn"
            class="apple-btn-primary w-full sm:flex-1 h-[42px] text-[14px] font-medium justify-center shadow-[0_4px_16px_rgba(0,113,227,0.3)] hover:shadow-[0_4px_24px_rgba(0,113,227,0.5)] transition-all cursor-pointer"
          >
            <span>Enviar solicitud de proyecto</span>
            <SFSymbol name="paperplane" class="w-3.5 h-3.5" />
          </button>

          <a
            href="mailto:contact@noctivagos.studio"
            class="apple-btn-secondary w-full sm:w-auto h-[42px] text-[13px] px-4 justify-center"
          >
            <span>O enviar email directo</span>
          </a>
        </div>

        <!-- Form Status Message -->
        <div
          id="cta-form-status"
          class="hidden text-[13px] text-center p-3 rounded-xl border transition-all"
        ></div>
      </form>
    </div>

    <!-- Apple Reassurance & SLA Specs -->
    <div class="reveal-item inline-flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-4 border-t border-white/[0.08] text-[11px] text-[#86868b]" style="transition-delay: 320ms;">
      <div class="flex items-center gap-1.5">
        <SFSymbol name="checkmark" class="w-3.5 h-3.5 text-[#30d158]" />
        <span>Direct communication</span>
      </div>
      <div class="flex items-center gap-1.5">
        <SFSymbol name="lock.shield" class="w-3.5 h-3.5 text-[#ffd60a]" />
        <span>Production-ready code</span>
      </div>
      <div class="flex items-center gap-1.5">
        <SFSymbol name="paperplane" class="w-3.5 h-3.5 text-[#2997ff]" />
        <span>Response within 24 hours</span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('cta-contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('cta-form-status');
  const submitBtn = document.getElementById('cta-submit-btn') as HTMLButtonElement | null;

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const phone = formData.get('phone') as string;
      const service = formData.get('service') as string;
      const budget = formData.get('budget') as string;
      const message = formData.get('message') as string;

      // Loading state
      submitBtn.disabled = true;
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = `<span>Enviando...</span>`;

      setTimeout(() => {
        // Build email body for direct mail client fallback or confirmation
        const subject = encodeURIComponent(`Nuevo Proyecto: ${name} (${service})`);
        const body = encodeURIComponent(
          `Nombre: ${name}\nEmail: ${email}\nTeléfono: ${phone || 'N/A'}\nServicio: ${service}\nPresupuesto: ${budget}\n\nDetalles:\n${message}`
        );

        statusDiv.className = 'text-[13px] text-center p-3.5 rounded-xl border border-[#30d158]/30 bg-[#30d158]/10 text-[#30d158] block';
        statusDiv.innerHTML = `
          <div class="flex flex-col items-center gap-1">
            <span class="font-semibold">¡Solicitud enviada con éxito!</span>
            <span class="text-[12px] text-[#f5f5f7]/80">Hemos recibido tus datos y te responderemos en menos de 24 horas.</span>
          </div>
        `;

        form.reset();
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }, 600);
    });
  }
</script>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Projects from "../components/Projects.astro";
import Differentiators from "../components/Differentiators.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="NOCTIVAGOS STUDIOS — Precision Digital Studio & Engineering"
  description="Noctivagos Studios designs and develops high-performance digital experiences that combine strategy, design and technology."
>
  <!-- Global Navigation -->
  <Header />

  <!-- Main Content Sequence: BLACK → WHITE Rhythm -->
  <main>
    <!-- 01 — HERO (BLACK) -->
    <Hero />

    <!-- 02 — MANIFESTO (WHITE) -->
    <Manifesto />

    <!-- 03 — SERVICES (BLACK) -->
    <Services />

    <!-- 04 — PROCESS (WHITE) -->
    <Process />

    <!-- 05 — WORK (BLACK) -->
    <Projects />

    <!-- 06 — DIFFERENTIATORS (WHITE) -->
    <Differentiators />

    <!-- 07 — FINAL CTA (BLACK) -->
    <CTA />
  </main>

  <!-- 08 — FOOTER (WHITE) -->
  <Footer />
</Layout>

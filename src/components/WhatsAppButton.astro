---
interface Props {
  phoneNumber?: string;
  defaultMessage?: string;
}

const {
  phoneNumber = "5491100000000", // Puede configurarse o reemplazarse con el número oficial
  defaultMessage = "Hola Noctivagos Studios, me gustaría cotizar un proyecto.",
} = Astro.props;

const encodedMessage = encodeURIComponent(defaultMessage);
const whatsappUrl = phoneNumber 
  ? `https://wa.me/${phoneNumber}?text=${encodedMessage}` 
  : `https://api.whatsapp.com/send?text=${encodedMessage}`;
---

<!-- Botón flotante de WhatsApp (glass + resplandor de marca) -->
<aside class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50">
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    class="group relative flex items-center gap-2.5 px-3.5 py-3 sm:px-4 sm:py-3 rounded-full bg-[#121214]/90 backdrop-blur-xl border border-white/[0.14] text-[#f5f5f7] shadow-[0_8px_32px_rgba(0,0,0,0.6),0_0_24px_rgba(37,211,102,0.25)] hover:shadow-[0_8px_36px_rgba(37,211,102,0.45)] hover:border-[#25D366]/60 hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 ease-out"
  >
    <!-- Aura pulsante alrededor del ícono -->
    <span class="relative flex h-7 w-7 items-center justify-center">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-30"></span>
      <span class="relative inline-flex items-center justify-center rounded-full h-7 w-7 bg-[#25D366] text-black shadow-sm">
        <!-- Trazo SVG oficial de WhatsApp -->
        <svg
          class="w-4 h-4 text-white fill-current"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M17.472 14.382c-.301-.15-1.782-.879-2.058-.979-.276-.1-.477-.15-.678.15-.2.301-.778.979-.954 1.18-.176.2-.351.226-.653.075-.301-.15-1.272-.469-2.423-1.496-.896-.799-1.501-1.787-1.677-2.088-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.151-.176.201-.301.302-.502.1-.2.05-.376-.025-.527-.075-.15-.678-1.633-.929-2.235-.245-.586-.494-.507-.678-.516-.176-.008-.377-.01-.578-.01-.201 0-.528.075-.804.376s-1.055 1.03-1.055 2.511c0 1.482 1.08 2.912 1.231 3.113.151.201 2.126 3.246 5.152 4.554.72.311 1.282.497 1.72.636.724.23 1.383.198 1.904.12.58-.088 1.782-.728 2.033-1.431.251-.703.251-1.306.176-1.431-.075-.125-.276-.201-.577-.351zM12.04 2C6.54 2 2.08 6.46 2.08 11.96c0 1.758.46 3.473 1.332 4.985L2 22l5.201-1.365c1.458.796 3.104 1.217 4.839 1.217 5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.036-5.16-2.92-7.043C17.2 2.96 14.7 2 12.04 2zm0 18.243c-1.536 0-3.042-.413-4.354-1.192l-.312-.185-3.237.849.864-3.156-.203-.323c-.856-1.36-1.308-2.937-1.308-4.57 0-4.664 3.796-8.46 8.46-8.46 2.26 0 4.385.88 5.983 2.478 1.597 1.597 2.477 3.722 2.477 5.982 0 4.664-3.796 8.46-8.46 8.46z"/>
        </svg>
      </span>
    </span>

    <!-- Etiqueta con indicador de estado -->
    <div class="flex flex-col text-left pr-1">
      <div class="flex items-center gap-1.5">
        <span class="text-[12.5px] font-medium tracking-tight text-[#f5f5f7] group-hover:text-white transition-colors">
          WhatsApp
        </span>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
      </div>
      <span class="hidden sm:inline-block text-[10px] text-[#86868b] group-hover:text-[#a1a1a6] transition-colors leading-tight">
        Respuesta rápida
      </span>
    </div>
  </a>
</aside>

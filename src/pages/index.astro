---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Projects from "../components/Projects.astro";
import Differentiators from "../components/Differentiators.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="NOCTIVAGOS STUDIOS — Estudio Digital & Ingeniería de Precisión"
  description="Noctivagos Studios diseña y desarrolla experiencias digitales de alto rendimiento que combinan estrategia, diseño y tecnología moderna."
>
  <!-- Navegación global -->
  <Header />

  <!-- Secuencia principal: ritmo NEGRO → BLANCO -->
  <main>
    <!-- 01 — HERO (NEGRO) -->
    <Hero />

    <!-- 02 — MANIFIESTO (BLANCO) -->
    <Manifesto />

    <!-- 03 — SERVICIOS (NEGRO) -->
    <Services />

    <!-- 04 — PROCESO (BLANCO) -->
    <Process />

    <!-- 05 — TRABAJOS (NEGRO) -->
    <Projects />

    <!-- 06 — DIFERENCIADORES (BLANCO) -->
    <Differentiators />

    <!-- 07 — CTA FINAL (NEGRO) -->
    <CTA />
  </main>

  <!-- 08 — PIE DE PÁGINA (BLANCO) -->
  <Footer />
</Layout>

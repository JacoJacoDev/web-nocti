---
import SFSymbol from './SFSymbol.astro';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: "Capacidades",
    links: [
      { href: "#services", label: "Desarrollo Web" },
      { href: "#services", label: "Diseño UX/UI" },
      { href: "#services", label: "Landing Pages" },
      { href: "#services", label: "Plataformas Corporativas" },
      { href: "#services", label: "E-commerce" },
      { href: "#services", label: "Automatización & APIs" },
    ],
  },
  {
    title: "Metodología",
    links: [
      { href: "#process", label: "01 Descubrimiento" },
      { href: "#process", label: "02 Estrategia" },
      { href: "#process", label: "03 Diseño" },
      { href: "#process", label: "04 Desarrollo" },
      { href: "#process", label: "05 Lanzamiento" },
    ],
  },
  {
    title: "Trabajos",
    links: [
      { href: "#work", label: "PISOALTO REALTY" },
      { href: "#work", label: "Todos los casos" },
    ],
  },
  {
    title: "Valores del Estudio",
    links: [
      { href: "#about", label: "Intencionalidad" },
      { href: "#differentiators", label: "Estándares de Rendimiento" },
      { href: "#differentiators", label: "Accesibilidad Fluida" },
      { href: "#differentiators", label: "Escalabilidad del Sistema" },
    ],
  },
  {
    title: "Consultas & Contacto",
    links: [
      { href: "mailto:contact@noctivagos.studio", label: "contact@noctivagos.studio" },
      { href: "https://x.com", label: "X (Twitter)" },
      { href: "https://github.com", label: "GitHub" },
      { href: "https://linkedin.com", label: "LinkedIn" },
    ],
  },
];
---

<footer class="relative px-4 sm:px-8 py-10 md:py-12 bg-[#f5f5f7] text-[#1d1d1f] border-t border-[#d2d2d7] text-[12px]">
  <div class="max-w-[1024px] mx-auto">
    <!-- Sección de notas al pie -->
    <div class="pb-5 border-b border-[#d2d2d7] text-[11px] text-[#86868b] leading-normal space-y-1.5">
      <p>
        1. Noctivagos Studios es un estudio independiente de tecnología y diseño. Todos los proyectos mostrados están construidos siguiendo estándares modernos del W3C, presupuestos de latencia sub-segundo y un cumplimiento riguroso de accesibilidad.
      </p>
      <p>
        2. Las métricas de rendimiento corresponden a compilaciones de producción medidas con Lighthouse headless y herramientas de Core Web Vitals, bajo simulaciones de red limitadas en condiciones reales.
      </p>
    </div>

    <!-- Directorio de múltiples columnas -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5 sm:gap-6 py-6 sm:py-8">
      {columns.map((col) => (
        <div>
          <h3 class="font-semibold text-[#1d1d1f] tracking-tight mb-2 text-[12px]">
            {col.title}
          </h3>
          <ul class="space-y-1.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[#6e6e73] hover:text-[#1d1d1f] transition-colors text-[11.5px]"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Barra legal y de copyright -->
    <div class="pt-5 border-t border-[#d2d2d7] flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-[11px] text-[#6e6e73]">
      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5">
        <p>Copyright &copy; {currentYear} Noctivagos Studios. Todos los derechos reservados.</p>
        <span class="hidden sm:inline text-[#d2d2d7]">|</span>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Política de Privacidad</a>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Términos de Uso</a>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Estándares de Ingeniería</a>
        <a href="#" class="hover:text-[#1d1d1f] transition-colors">Legal</a>
      </div>

      <div class="flex items-center gap-2 text-[#1d1d1f] font-medium">
        <SFSymbol name="globe" class="w-3.5 h-3.5 text-[#86868b]" />
        <span>Estudio Global (Remoto)</span>
      </div>
    </div>
  </div>
</footer>

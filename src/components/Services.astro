---
import SFSymbol from "./SFSymbol.astro";

const services = [
  {
    num: "01",
    symbol: "terminal",
    title: "Desarrollo Web",
    description: "Sitios web de alto rendimiento para negocios modernos.",
    details:
      "Código semántico limpio, bundles optimizados y estándares web modernos y resistentes.",
  },
  {
    num: "02",
    symbol: "paintpalette",
    title: "Diseño UX/UI",
    description:
      "Interfaces diseñadas en torno a la claridad, la usabilidad y la interacción intencional.",
    details:
      "Jerarquías ergonómicas, sistemas de movimiento fluidos y manipulación directa.",
  },
  {
    num: "03",
    symbol: "globe",
    title: "Landing Pages",
    description:
      "Experiencias digitales enfocadas en comunicar valor e impulsar la acción.",
    details:
      "Mensajes sin fricción, arquitectura de alta conversión y respuesta inmediata.",
  },
  {
    num: "04",
    symbol: "building",
    title: "Sitios Corporativos",
    description:
      "Plataformas digitales profesionales que respaldan la credibilidad y comunican con claridad.",
    details:
      "Estructuradas para escalar a largo plazo, con fidelidad multidispositivo y sello propio.",
  },
  {
    num: "05",
    symbol: "bag",
    title: "E-commerce",
    description:
      "Experiencias de comercio escalables, optimizadas para usabilidad y rendimiento.",
    details:
      "Checkouts sin fricción, exploración de productos ágil e infraestructura resiliente.",
  },
  {
    num: "06",
    symbol: "bolt",
    title: "Automatización & Integraciones",
    description:
      "Conectamos sitios web con las herramientas y sistemas que tu negocio ya usa.",
    details:
      "Flujos headless, sincronización con CRM, APIs a medida y pipelines operativos automatizados.",
  },
];
---

<section
  id="services"
  class="relative px-4 sm:px-8 py-12 md:py-16 bg-[#000000] text-[#f5f5f7] overflow-hidden"
>
  <div class="relative z-10 max-w-[960px] mx-auto">
    <!-- Eyebrow -->
    <div class="reveal-item flex items-center gap-2 mb-3">
      <SFSymbol name="layers" class="w-3.5 h-3.5 text-[#2997ff]" />
      <span class="apple-eyebrow text-[#2997ff]">03 — Capacidades</span>
    </div>

    <!-- Titular de introducción -->
    <div class="reveal-item max-w-3xl mb-6" style="transition-delay: 80ms;">
      <h2 class="apple-headline-section text-[#f5f5f7] tracking-tight mb-2">
        Diseñados con precisión y escalabilidad.
      </h2>
      <p class="apple-body-large text-[#86868b] font-normal">
        Entregamos soluciones digitales que eliminan la complejidad y priorizan
        la ejecución impecable.
      </p>
    </div>

    <!-- Grid de capacidades (2 columnas, tarjetas bento redondeadas) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
      {
        services.map((service, index) => (
          <div
            class="reveal-item apple-card-dark p-4 sm:p-5 group hover:border-white/[0.2] transition-all duration-300"
            style={`transition-delay: ${index * 50}ms;`}
          >
            <div class="flex items-center justify-between mb-2.5">
              <div class="w-8 h-8 rounded-lg bg-[#1d1d1f] border border-white/[0.08] flex items-center justify-center text-[#2997ff] group-hover:scale-105 transition-transform duration-200">
                <SFSymbol name={service.symbol as any} class="w-3.5 h-3.5" />
              </div>
              <span class="text-[11px] font-mono text-[#86868b] font-medium">
                {service.num}
              </span>
            </div>

            <h3 class="text-[16px] sm:text-[17px] font-semibold tracking-tight text-[#f5f5f7] mb-1 group-hover:text-white transition-colors">
              {service.title}
            </h3>

            <p class="apple-body-small text-[#f5f5f7]/90 mb-1.5 font-normal text-[13px]">
              {service.description}
            </p>

            <p class="text-[11.5px] text-[#86868b] mb-2.5 leading-relaxed">
              {service.details}
            </p>

            <div class="pt-2.5 border-t border-white/[0.06] flex items-center justify-between">
              <a href="#contact" class="apple-link text-[12.5px]">
                <span>Ver servicio</span>
                <SFSymbol
                  name="chevron.right"
                  class="w-2.5 h-2.5 text-[#2997ff]"
                />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
import SFSymbol from './SFSymbol.astro';

const projects = [
  {
    name: "PISOALTO REALTY",
    category: "Real Estate · Digital Experience",
    symbol: "building",
    description: "An archival digital repository exploring raw spatial materiality, brutalist form, and dynamic indexing.",
    image: "/images/projects/kinetic.jpg",
    alt: "Kinetic Archive minimal architectural web interface",
    href: "#",
  },
];
---

<section
  id="work"
  class="relative px-4 sm:px-8 py-12 md:py-16 bg-[#000000] text-[#f5f5f7] overflow-hidden"
>
  <div class="relative z-10 max-w-[960px] mx-auto">
    <!-- Apple Eyebrow -->
    <div class="reveal-item flex items-center gap-2 mb-3">
      <SFSymbol name="sparkles" class="w-3.5 h-3.5 text-[#2997ff]" />
      <span class="apple-eyebrow text-[#2997ff]">05 — Selected Work</span>
    </div>

    <!-- Section Intro Headline -->
    <div class="reveal-item max-w-3xl mb-6">
      <h2 class="apple-headline-section text-[#f5f5f7] tracking-tight mb-2">
        Form informed by function.
      </h2>
      <p class="apple-body-large text-[#86868b] font-normal">
        A curated selection of digital platforms engineered with uncompromising standards of craft and performance.
      </p>
    </div>

    <!-- Apple-style Showcase Articles (Compact Spacing) -->
    <div class="space-y-6 md:space-y-8">
      {projects.map((project, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <article
            class="reveal-item apple-card-dark p-3.5 sm:p-5 group grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 items-center"
            style={`transition-delay: ${index * 60}ms;`}
          >
            <!-- Project Image Frame -->
            <div class={`lg:col-span-7 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <a
                href={project.href}
                class="block relative overflow-hidden rounded-xl bg-[#000000] border border-white/[0.08]"
                aria-label={`View project ${project.name}`}
              >
                <div class="aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden">
                  <img
                    src={project.image}
                    alt={project.alt}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                  />
                </div>
              </a>
            </div>

            <!-- Project Details & Typography -->
            <div class={`lg:col-span-5 flex flex-col justify-center space-y-2.5 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
              <div class="inline-flex items-center gap-2 text-[#86868b] text-[11px] font-medium tracking-tight">
                <SFSymbol name={project.symbol as any} class="w-3.5 h-3.5 text-[#2997ff]" />
                <span>{project.category}</span>
              </div>
              
              <h3 class="text-[20px] sm:text-[23px] font-semibold tracking-tight text-[#f5f5f7] group-hover:text-white transition-colors">
                {project.name}
              </h3>

              <p class="apple-body-small text-[#86868b] font-normal text-[13px]">
                {project.description}
              </p>

              <div class="pt-1.5">
                <a
                  href={project.href}
                  class="apple-link text-[13.5px]"
                >
                  <span>Explore case study</span>
                  <SFSymbol name="arrow.up.right" class="w-3 h-3 text-[#2997ff]" />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

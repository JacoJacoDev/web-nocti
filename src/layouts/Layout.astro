---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NOCTIVAGOS STUDIOS — Estudio Digital & Tecnología",
  description = "Noctivagos Studios diseña y desarrolla experiencias digitales de alto rendimiento que combinan estrategia, diseño y tecnología moderna.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />

    <!-- Metaetiquetas SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Noctivagos Studios" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="bg-[#0a0a0a] text-white antialiased selection:bg-white selection:text-black">
    <slot />

    <!-- Interacción global flotante de WhatsApp -->
    <WhatsAppButton />

    <script>
      import { initHeader } from '../scripts/header';
      import { initScrollReveal } from '../scripts/scroll-reveal';

      document.addEventListener('DOMContentLoaded', () => {
        initHeader();
        initScrollReveal();
      });
    </script>
  </body>
</html>

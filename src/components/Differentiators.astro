---
import SFSymbol from './SFSymbol.astro';

const differentiators = [
  {
    title: "DISEÑO",
    symbol: "paintpalette",
    summary: "Interfaces construidas en torno a la claridad y la intencionalidad.",
    detail: "Las decisiones visuales se apoyan en la ergonomía cognitiva, la jerarquía tipográfica y una contención deliberada.",
  },
  {
    title: "RENDIMIENTO",
    symbol: "gauge",
    summary: "Experiencias rápidas pensadas para el uso real.",
    detail: "Arquitecturas livianas diseñadas para una primera pintura de contenido inmediata, baja latencia y cero desplazamiento de diseño.",
  },
  {
    title: "ADAPTATIVO",
    symbol: "devices",
    summary: "Layouts que se adaptan de forma natural a cada dispositivo.",
    detail: "Viewports a medida, desde pantallas móviles compactas hasta monitores ultrawide, sin comprometer la composición.",
  },
  {
    title: "CONVERSIÓN",
    symbol: "chart.line",
    summary: "Experiencias digitales diseñadas para llevar al usuario a acciones significativas.",
    detail: "Mapeo claro de la información yJerarquías espaciales intuitivas que eliminan la fricción del usuario.",
  },
  {
    title: "ESCALABILIDAD",
    symbol: "layers",
    summary: "Sistemas estructurados para evolucionar junto al negocio.",
    detail: "Arquitecturas basadas en componentes y bases de código limpias, preparadas para crecer de forma modular con el tiempo.",
  },
  {
    title: "TECNOLOGÍA",
    symbol: "cpu",
    summary: "Tecnología moderna usada solo cuando aporta valor real.",
    detail: "Elecciones de stack pragmáticas, priorizando mantenibilidad, estabilidad y velocidad en lugar de modas pasajeras.",
  },
];
---

<section
  id="differentiators"
  class="relative px-4 sm:px-8 py-12 md:py-16 bg-[#ffffff] text-[#1d1d1f]"
>
  <div class="max-w-[960px] mx-auto">
    <!-- Eyebrow -->
    <div class="reveal-item flex items-center gap-2 mb-3">
      <SFSymbol name="cpu" class="w-3.5 h-3.5 text-[#0071e3]" />
      <span class="apple-eyebrow text-[#0071e3]">06 — Estándares de Ingeniería</span>
    </div>

    <!-- Titular -->
    <div class="reveal-item max-w-3xl mb-6">
      <h2 class="apple-headline-section text-[#1d1d1f] tracking-tight mb-2">
        Lo que define nuestro trabajo.
      </h2>
      <p class="apple-body-large text-[#86868b] font-normal">
        Noctivagos Studios combina la sensibilidad del diseño con la disciplina
        de la ingeniería para crear productos digitales duraderos.
      </p>
    </div>

    <!-- Grid de features bento (compacto) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
      {differentiators.map((item, index) => (
        <div
          class="reveal-item apple-card-light p-4 sm:p-4.5 flex flex-col justify-between hover:border-[#0071e3]/40 transition-colors duration-200"
          style={`transition-delay: ${index * 40}ms;`}
        >
          <div>
            <div class="w-8 h-8 rounded-lg bg-white border border-[#d2d2d7] flex items-center justify-center text-[#0071e3] mb-2.5 shadow-sm">
              <SFSymbol name={item.symbol as any} class="w-3.5 h-3.5" />
            </div>

            <h3 class="apple-caption font-semibold tracking-wider text-[#0071e3] uppercase mb-1">
              {item.title}
            </h3>

            <p class="text-[15px] sm:text-[16px] font-semibold tracking-tight text-[#1d1d1f] mb-1.5 leading-snug">
              {item.summary}
            </p>
          </div>

          <p class="text-[11.5px] text-[#86868b] pt-2 border-t border-[#d2d2d7]/50 mt-2 leading-relaxed">
            {item.detail}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

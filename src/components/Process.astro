---
import SFSymbol from './SFSymbol.astro';

const steps = [
  {
    num: "01",
    symbol: "magnifyingglass",
    title: "Descubrimiento",
    tagline: "Entender el negocio, la audiencia y los objetivos.",
    description: "Aclaramos el alcance del producto, las restricciones operativas y los resultados esperados antes de escribir una línea de código.",
  },
  {
    num: "02",
    symbol: "compass",
    title: "Estrategia",
    tagline: "Definir la estructura, el posicionamiento y la dirección digital.",
    description: "Mapeamos la arquitectura de información, los flujos de interacción y la infraestructura técnica para máximo rendimiento.",
  },
  {
    num: "03",
    symbol: "paintpalette",
    title: "Diseño",
    tagline: "Crear el sistema visual y la experiencia de usuario.",
    description: "Cada layout, regla tipográfica y transición de estado está pensada para comunicar valor sin ruido visual.",
  },
  {
    num: "04",
    symbol: "hammer",
    title: "Desarrollo",
    tagline: "Convertir el diseño en una experiencia digital rápida y adaptable.",
    description: "Ingeniería con estándares web modernos, código liviano y prácticas rigurosas de accesibilidad.",
  },
  {
    num: "05",
    symbol: "paperplane",
    title: "Lanzamiento",
    tagline: "Probar, optimizar y preparar todo para producción.",
    description: "Auditorías exhaustivas en todos los dispositivos, pruebas de latencia y validación SEO antes del despliegue.",
  },
];
---

<section
  id="process"
  class="relative px-4 sm:px-8 py-12 md:py-16 bg-[#f5f5f7] text-[#1d1d1f]"
>
  <div class="max-w-[960px] mx-auto">
    <!-- Eyebrow -->
    <div class="reveal-item flex items-center gap-2 mb-3">
      <SFSymbol name="slider" class="w-3.5 h-3.5 text-[#0071e3]" />
      <span class="apple-eyebrow text-[#0071e3]">04 — Metodología</span>
    </div>

    <!-- Titular de introducción -->
    <div class="reveal-item max-w-3xl mb-6">
      <h2 class="apple-headline-section text-[#1d1d1f] tracking-tight mb-2">
        Un camino deliberado hacia producción.
      </h2>
      <p class="apple-body-large text-[#86868b] font-normal">
        Estructurado, transparente e iterativo. Eliminamos la improvisación con
        ingeniería disciplinada.
      </p>
    </div>

    <!-- Grid de línea de tiempo por pasos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3">
      {steps.map((step, index) => (
        <div
          class="process-card reveal-item bg-[#ffffff] border border-[#d2d2d7] rounded-xl p-3 sm:p-3.5 flex flex-col justify-between shadow-[0_2px_8px_rgba(0,0,0,0.03)] hover:shadow-[0_4px_14px_rgba(0,0,0,0.06)]"
          style={`--reveal-delay: ${index * 60}ms;`}
        >
          <div>
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-[11px] font-mono font-medium text-[#86868b]">
                {step.num}
              </span>
              <div class="w-6 h-6 rounded-md bg-[#f5f5f7] flex items-center justify-center text-[#0071e3]">
                <SFSymbol name={step.symbol as any} class="w-3 h-3" />
              </div>
            </div>

            <h3 class="text-[15px] sm:text-[16px] font-semibold tracking-tight text-[#1d1d1f] mb-1">
              {step.title}
            </h3>

            <p class="text-[11.5px] font-medium text-[#1d1d1f] leading-snug mb-1.5">
              {step.tagline}
            </p>
          </div>

          <p class="text-[11px] text-[#86868b] leading-relaxed pt-2 border-t border-[#e8e8ed] mt-2">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
